          "_name": "gallery05",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery05\" group=\"Gallery & Slider\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-fullscreen': fullScreen,'mbr-parallax-background': bg.parallax}\">\n    <mbr-parameters>\n        <header>Size</header>\n        <input type=\"checkbox\" title=\"Full Screen\" name=\"fullScreen\">\n        <input type=\"checkbox\" title=\"Full Width\" name=\"fullWidth\" checked>\n        <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\" condition=\"fullScreen == false\">\n        <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"1\" condition=\"fullScreen == false\">\n        <input type=\"checkbox\" title=\"Reverse\" name=\"reverseContent\" checked>\n        <header>Show/Hide</header>\n        <input type=\"checkbox\" title=\"Title\" name=\"showTitle\">\n        <input type=\"checkbox\" title=\"Text\" name=\"showText\">\n        <header>Image</header>\n        <input type=\"checkbox\" name=\"autoSize\" title=\"Auto Size\" checked>\n        <input type=\"range\" name=\"imageHeight\" title=\"Height\" min=\"1\" max=\"5\" step=\"1\" value=\"3\" condition=\"autoSize\">\n        <header>Background</header>\n        <fieldset type=\"background\" name=\"bg\" parallax>\n            <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n            <input type=\"color\" title=\"Color\" value=\"#ffffff\" selected>\n            <input type=\"video\" title=\"Video\" value=\"https://vimeo.com/428046504\">\n        </fieldset>\n        <header condition=\"bg.type === 'video'\">Fallback Image</header>\n        <input type=\"image\" title=\"Fallback Image\" value=\"../_images/background1.jpg\" name=\"fallBackImage\" condition=\"bg.type === 'video'\">\n        <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" condition=\"bg.type !== 'color'\" checked>\n        <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#ffffff\" condition=\"overlay && bg.type !== 'color'\">\n        <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n    </mbr-parameters>\n\n    <div class=\"mbr-fallback-image disabled\" mbr-if=\"bg.type == 'video'\"></div>\n    <div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\"></div>\n    <div mbr-class=\"{'container': !fullWidth, 'container-fluid': fullWidth}\">\n        <div class=\"row justify-content-center\" mbr-if=\"showTitle || showText\">\n            <div class=\"col-md-12 content-head mb-5\">\n                <h1 class=\"mbr-section-title mbr-fonts-style  mb-0\" data-app-selector=\".mbr-section-title\" mbr-theme-style=\"display-2\" mbr-if=\"showTitle\">\n                    <b>Villa 101</b></h1>\n                <p class=\"mbr-text mbr-fonts-style mt-4 mb-0\" mbr-theme-style=\"display-7\" mbr-if=\"showText\" data-app-selector=\".mbr-text, .mbr-section-btn\">Villa 101 is located at the left side of the building complex, as you can see below. Every detail—from soft linens to a private entrance—has been curated to ensure a restful and enjoyable stay.&nbsp;Recently renovated and thoughtfully designed, this detached holiday home blends modern amenities with timeless charm. Unwind in the lush garden or enjoy morning coffee on your private terrace with stunning views of the mountains, garden, and local landmarks. Free WiFi is available throughout the property, so you can stay connected while you relax.</p>\n            </div>\n        </div>\n        <div class=\"row justify-content-center  blockContent\">\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"row\">\n                    <div class=\"col-xs-12 col-sm-12 col-md-6 col-lg-6 active\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/ktima-drilli-125.webp\" alt title data-slide-to=\"0\" data-bs-slide-to=\"0\" class=\"smallImage\">\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"col-md-6 col-xs-12 col-sm-12 col-lg-6\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/ktima-drilli-108.webp\" alt title data-slide-to=\"1\" data-bs-slide-to=\"1\" class=\"smallImage\">\n                            </div>\n\n                        </div>\n                    </div>\n                    <div class=\"col-xs-12 col-sm-12 col-md-6 col-lg-6\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/ktima-drilli-61.webp\" alt title data-slide-to=\"2\" data-bs-slide-to=\"2\" class=\"smallImage\">\n                            </div>\n                        </div>\n                    </div>\n                    <div class=\"col-xs-12 col-sm-12 col-md-6 col-lg-6\">\n                        <div class=\"item-wrapper\">\n                            <div class=\"item-img\">\n                                <img src=\"@PROJECT_PATH@/assets/images/ktima-drilli-32.webp\" alt title data-slide-to=\"3\" data-bs-slide-to=\"3\" class=\"smallImage\">\n                            </div>\n                        </div>\n                    </div>\n                </div>\n            </div>\n            <div class=\"col-12 col-lg-6\">\n                <div class=\"item-wrapper\">\n                    <div class=\"item-img \">\n                        <img class=\"w-100 largeImage\" src=\"@PROJECT_PATH@/assets/images/ktima-drilli-3.webp\" alt data-slide-to=\"3\" data-bs-slide-to=\"3\">\n                    </div>\n\n                </div>\n            </div>\n        </div>\n    </div>\n</section>",
          "_cid": "uOdE4s31V1",
          "_anchor": "gallery05-f",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
        },
        {
          "alias": false,
          "_styles": {
            "padding-top": "(@paddingTop * 1rem)",
            "padding-bottom": "(@paddingBottom * 1rem)",
            "& when (@bg-type = \"color\")": {
              "background-color": "@bg-value"
            },
            "& when (@bg-type = \"image\")": {
              "background-image": "url(@bg-value)",
              "& when (@overlay)": {
                ".mbr-overlay": {
                  "background": "@overlayColor",
                  "opacity": "@overlayOpacity"
                }
              }
            },
            ".item:focus, span:focus": {
              "outline": "none"
            },
            ".item": {
              "cursor": "pointer"
            },
            ".container-fluid": {
              "padding-left": "0",
              "padding-right": "0",
              "overflow": "hidden"
            },
            ".content-head": {
              "max-width": "800px"
            },
            "@keyframes ticker": {
              "0%": {
                "transform": "translate3d(0, 0, 0)",
                "visibility": "visible"
              },
              "100%": {
                "transform": "translate3d(-100%, 0, 0)"
              }
            },
            ".ticker-wrap": {
              "width": "100%",
              "overflow": "hidden",
              "padding-left": "100%",
              "box-sizing": "content-box",
              ".ticker": {
                "display": "inline-block",
                "line-height": "4rem",
                "white-space": "nowrap",
                "padding-right": "100%",
                "box-sizing": "content-box",
                "animation-iteration-count": "infinite",
                "animation-timing-function": "linear",
                "animation-name": "ticker",
                "animation-duration": "(@durationTopLine * 1s)",
                "&__item": {
                  "display": "inline-block",
                  "padding": "0 2rem",
                  "color": "@contentColor"
                }
              },
              "@keyframes ticker__center": {
                "0%": {
                  "transform": "translate3d(0, 0, 0)",
                  "visibility": "visible"
                },
                "100%": {
                  "transform": "translate3d(-100%, 0, 0)"
                }
              },
              ".ticker__center": {
                "display": "inline-block",
                "line-height": "4rem",
                "white-space": "nowrap",
                "padding-right": "100%",
                "box-sizing": "content-box",
                "animation-iteration-count": "infinite",
                "animation-timing-function": "linear",
                "animation-name": "ticker__center",
                "animation-duration": "(@durationCenterLine * 1s)"
              },
              "@keyframes ticker__end": {
                "0%": {
                  "transform": "translate3d(0, 0, 0)",
                  "visibility": "visible"
                },
                "100%": {
                  "transform": "translate3d(-100%, 0, 0)"
                }
              },
              ".ticker__end": {
                "display": "inline-block",
                "line-height": "4rem",
                "white-space": "nowrap",
                "padding-right": "100%",
                "box-sizing": "content-box",
                "animation-iteration-count": "infinite",
                "animation-timing-function": "linear",
                "animation-name": "ticker__end",
                "animation-duration": "(@durationEndLine * 1s)"
              }
            },
            ".mbr-section-title, .mbr-section-subtitle": {
              "color": "#000000"
            }
          },
          "_name": "gallery08",
          "_sourceTheme": "startm5",
          "_customHTML": "<section data-bs-version=\"5.1\" class=\"gallery08\" group=\"Gallery\" data-bg-video=\"{{bg.type == 'video' && bg.value.url}}\" mbr-class=\"{'mbr-parallax-background': bg.parallax}\">\n  <mbr-parameters>\n    <header>Size</header>\n    <input type=\"range\" inline title=\"Top\" name=\"paddingTop\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n    <input type=\"range\" inline title=\"Bottom\" name=\"paddingBottom\" min=\"0\" max=\"10\" step=\"1\" value=\"2\">\n    \n    <header>Animated Text Settings</header>\n    <select title=\"Font style\" name=\"linesTitle\">\n      <option value=\"title1\" selected>Title 1</option>\n      <option value=\"title2\">Title 2</option>\n      <option value=\"title3\">Title 3</option>\n      <option value=\"text\">Text</option>\n      <option value=\"menu\">Menu</option>\n    </select>\n    <input type=\"text\" title=\"Line content 1\" inline name=\"animatedLine1\" value=\"2 υπνοδωμάτια (1 μεγάλο διπλό κρεβάτι, 2 μονά κρεβάτια) • Σαλόνι με 2 καναπέδες-κρεβάτια και τηλεόραση επίπεδης οθόνης\">\n    <input type=\"text\" title=\"Line content 2\" inline name=\"animatedLine2\" value=\"2 μοντέρνα μπάνια με μπουρνούζια, παντόφλες και δωρεάν προϊόντα περιποίησης • Πλυντήριο ρούχων, κλιματισμός και κομψά πλακάκια στο δάπεδο\">\n    <input type=\"text\" title=\"Line content 3\" inline name=\"animatedLine3\" value=\"Πλήρως εξοπλισμένη ιδιωτική κουζίνα με καφετιέρα, φούρνο και τραπεζαρία • Κάντε κράτηση τώρα!\">\n    <input type=\"range\" inline title=\"Line 1 duration\" name=\"durationTopLine\" min=\"1\" max=\"40\" step=\"1\" value=\"28\">\n    <input type=\"range\" inline title=\"Line 2 duration\" name=\"durationCenterLine\" min=\"1\" max=\"40\" step=\"1\" value=\"33\">\n    <input type=\"range\" inline title=\"Line 3 duration\" name=\"durationEndLine\" min=\"1\" max=\"40\" step=\"1\" value=\"39\">\n    <input type=\"color\" title=\"Content color\" value=\"#a56154\" name=\"contentColor\" selected>\n    <header>Background</header>\n    <fieldset type=\"background\" parallax name=\"bg\" required>\n      <input type=\"image\" title=\"Image\" value=\"../_images/background1.jpg\">\n      <input type=\"color\" title=\"Color\" value=\"#efd48b\" selected>\n    </fieldset>\n    <input type=\"checkbox\" title=\"Overlay\" name=\"overlay\" checked condition=\"bg.type !== 'color'\">\n    <input type=\"color\" title=\"Overlay Color\" name=\"overlayColor\" value=\"#f7f7f7\" condition=\"overlay && bg.type !== 'color'\">\n    <input type=\"range\" inline title=\"Opacity\" name=\"overlayOpacity\" min=\"0\" max=\"1\" step=\"0.1\" value=\"0.7\" condition=\"overlay && bg.type !== 'color'\">\n</mbr-parameters>\n\n<div class=\"mbr-overlay\" mbr-if=\"overlay && bg.type!== 'color'\" mbr-style=\"{'opacity': overlayOpacity, 'background-color': overlayColor}\">\n</div>\n  <div class=\"container-fluid gallery-wrapper\">\n\n    <div class=\"ticker-wrap\">\n      <div class=\"ticker\">\n        <div class=\"ticker__item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n        'display-5':linesTitle=='title3','display-7':linesTitle=='text',\n        'display-4':linesTitle=='menu'}\" data-word=\"{{animatedLine1}}\">Dream • Create • Inspire\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ticker-wrap\">\n      <div class=\"ticker ticker__center\">\n        <div class=\"ticker__item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n        'display-5':linesTitle=='title3','display-7':linesTitle=='text',\n        'display-4':linesTitle=='menu'}\" data-word=\"{{animatedLine2}}\">From idea to reality • Start small\n        </div>\n      </div>\n    </div>\n\n    <div class=\"ticker-wrap\">\n      <div class=\"ticker ticker__end\">\n        <div class=\"ticker__item\" mbr-class=\"{'display-1':linesTitle=='title1','display-2':linesTitle=='title2',\n        'display-5':linesTitle=='title3','display-7':linesTitle=='text',\n        'display-4':linesTitle=='menu'}\" data-word=\"{{animatedLine3}}\">Be fearless • Start now!\n        </div>\n      </div>\n    </div>\n  </div>\n</section>",
          "_cid": "uOe5y5zZ57",
          "_anchor": "gallery08-v",
          "_protectedParams": [],
          "_global": false,
          "_once": false,
          "_params": {}
