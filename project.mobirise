                    "padding-top": "0"
                  }
                },
                "& when not (@reverseContent)": {
                  ".text-element": {
                    "padding-bottom": "0"
                  }
                }
              },
              ".paragraphs-wrapper": {
                "-webkit-flex-direction": "column",
                "flex-direction": "column",
                ".first-paragraph, .second-paragraph": {
                  "width": "100%",
                  "padding": "0"
                }
              }
            },
            "@media (min-width: 768px)": {
              ".first-paragraph, .second-paragraph": {
                "width": "50%"
              },
              ".first-paragraph": {
                "padding-right": "0.5rem"
              },
              ".second-paragraph": {
                "padding-left": "0.5rem"
              },
              ".text-element": {
                "padding": "6rem",
                "& when not (@fullWidth)": {
                  "padding": "1rem"
                }
              }
            },
            "@media (max-width: 767px)": {
              ".mbr-section-title, .mbr-section-btn": {
                "text-align": "left"
              }
